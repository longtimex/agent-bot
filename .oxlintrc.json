{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "env": {
    "node": true,
    "es2022": true
  },
  "plugins": ["typescript", "unicorn", "import", "node"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-control-regex": "off",
    "no-unused-vars": ["warn", { "argsIgnorePattern": "^_", "varsIgnorePattern": "^_" }]
  },
  "ignorePatterns": [
    "dist/**",
    "node_modules/**",
    ".opencode/**",
    "android/**"
  ]
}
