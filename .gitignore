node_modules/
dist/
.env
# Cross-process lock and staging files the bot and `npm run setup` leave beside .env
.env.lock
.env.*.tmp
# Runtime state only. An unanchored `data/` also swallowed the Android
# source package com.agentbot.app.data, which must stay in the repo.
/data/
*.log
.DS_Store
.codex/
bin/
deploy/generated/
# Local assistant memory: useful across sessions, never part of the product
.workbuddy/

# Android toolchain output. Anchored: an unanchored `build/` would also match
# source directories, and `local.properties` carries this machine's SDK path.
android/local.properties
android/keystore.properties
android/*.jks
android/*.keystore
android/.gradle/
android/.kotlin/
android/build/
android/app/build/
/android/releases/
