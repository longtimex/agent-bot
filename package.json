{
  "name": "telegram-opencode-bot",
  "version": "0.4.0",
  "private": true,
  "type": "module",
  "description": "Private multi-client AI assistant for Telegram, Feishu and Android, backed by opencode and mainstream agent CLIs",
  "engines": {
    "node": ">=20.18.1"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "bot": "tsx src/bot-cli.ts",
    "smoke:app": "node scripts/app-smoke.mjs",
    "setup": "tsx src/setup-cli.ts",
    "setup:tools": "tsx src/install-tools-cli-entry.ts",
    "clients": "tsx src/setup-cli.ts --clients-only",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src tests scripts",
    "knip": "knip --include files,dependencies --no-config-hints",
    "check:android": "node scripts/check-android-sources.mjs",
    "check:size": "node scripts/check-size.mjs",
    "test": "node --import tsx --test tests/*.test.ts",
    "check": "npm run check:android && npm run lint && npm run check:size && npm run knip && npm run typecheck && npm test && npm run build",
    "serve": "opencode serve --port 4096 --hostname 127.0.0.1",
    "serve:proxy": "bash -c 'set -a; [ -f data/proxy.env ] && . data/proxy.env; set +a; exec opencode serve --port 4096 --hostname 127.0.0.1'",
    "restart": "tsx src/bot-cli.ts restart",
    "models": "tsx src/model-cli.ts",
    "cc-switch:install": "bash scripts/install-cc-switch.sh",
    "check:release": "node scripts/check-release.mjs",
    "release:control": "node dist/release-control.js",
    "release:android": "node scripts/publish-android-release.mjs"
  },
  "dependencies": {
    "@larksuiteoapi/node-sdk": "^1.76.0",
    "grammy": "^1.39.3",
    "playwright-core": "^1.64.1",
    "qrcode": "^1.5.4",
    "socks": "^2.8.10",
    "undici": "^7.30.2"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "@types/qrcode": "^1.5.6",
    "knip": "^6.44.1",
    "oxlint": "^1.91.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  }
}
