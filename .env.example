# ---------- Telegram Bot ----------
# 首次运行 npm start 缺少控制端配置时会自动进入多端连接向导；
# 也可随时运行 npm run setup 首次配置，或 npm run clients 添加其他控制端。
# 在 Telegram 中向 @BotFather 发送 /newbot 获取 Token
TELEGRAM_BOT_TOKEN=
# 允许使用机器人的 Telegram 用户 ID（逗号分隔）。留空将拒绝启动
TELEGRAM_ALLOW_USERS=
# 显式设为 1 才允许所有用户使用（不推荐）
TELEGRAM_ALLOW_ALL_USERS=0

# ---------- 飞书 Bot（可选，可与 Telegram/安卓同时运行） ----------
# 企业自建应用的 App ID / App Secret，在飞书开放平台「凭证与基础信息」获取。
# 只填其中一个会拒绝启动；Telegram、飞书、安卓 API 至少要配置一个。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
# 允许使用机器人的飞书 open_id（逗号分隔）。首次可临时设置
# FEISHU_ALLOW_ALL_USERS=1 启动，用 /access 查看 open_id；加入白名单后务必关闭 allow-all。
FEISHU_ALLOW_OPEN_IDS=
# 显式设为 1 才允许所有飞书用户使用（不推荐）
FEISHU_ALLOW_ALL_USERS=0
# 飞书面板按钮使用卡片回调；消息事件仍走长连接。启用时需提供公网可访问地址，
# 并在开放平台「事件与回调 → 回调配置」填写 http(s)://你的域名/feishu/card。
# 回调必须至少配置 Verification Token 或 Encrypt Key 之一，否则拒绝启动。
FEISHU_CALLBACK_ENABLED=0
FEISHU_CALLBACK_BIND=127.0.0.1
FEISHU_CALLBACK_PORT=3081
FEISHU_CALLBACK_PATH=/feishu/card
# 开放平台「事件与回调 → 加密策略」中的 Verification Token / Encrypt Key。
FEISHU_CALLBACK_VERIFICATION_TOKEN=
FEISHU_CALLBACK_ENCRYPT_KEY=

# ---------- opencode server ----------
OPENCODE_URL=http://127.0.0.1:4096
# 与启动 `opencode serve` 时的 OPENCODE_SERVER_PASSWORD 一致
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# 使用的 agent（定义在 .opencode/agent/assistant.md）
OPENCODE_AGENT=assistant

# ---------- Agent CLI ----------
# 自定义 Agent CLI 档案路径；留空时读取 data/agents.json
# 内置 Claude Code / Codex / Gemini / Qwen / Qoder 等档案无需配置
AGENT_CLI_CONFIG=

# ---------- 任务超时 ----------
# 无活动超时（毫秒），所有引擎共用
TASK_TIMEOUT_MS=600000
# 任务绝对上限（毫秒），默认与无活动超时一致
TASK_MAX_TIMEOUT_MS=600000

# ---------- 定时提醒 ----------
# 提醒时间解析使用的 IANA 时区（与服务器时区无关）
REMINDER_TIMEZONE=Asia/Shanghai

# ---------- 语音转写（可选，OpenAI 兼容 /audio/transcriptions 接口） ----------
# 留空关闭；配置后，模型不支持音频输入时语音会自动转写为文字
STT_BASE_URL=
STT_API_KEY=
STT_MODEL=whisper-1
STT_LANGUAGE=

# ---------- 每日用量报告 ----------
# 每天到点向白名单第一位用户推送一次用量汇总（0 关闭）
USAGE_DAILY_REPORT=0
# 推送时间（24 小时制 HH:MM，按 REMINDER_TIMEZONE 解析）
USAGE_DAILY_REPORT_TIME=21:00

# ---------- 其他 ----------
MAX_REPLY_LENGTH=1500
# 单条回复中单个图片/语音/文件最大大小（MB）
MAX_MEDIA_MB=20
# 允许媒体指令访问本机/内网地址（默认 0；仅在本地调试时临时设为 1）
MEDIA_ALLOW_PRIVATE_URLS=0
# 项目级入站附件上限（MB）。0 = 不限制单文件/总量字节数（仍受单条最多 4 个附件、磁盘与平台限制）
MAX_INPUT_MB=0
DATA_DIR=./data
LOG_LEVEL=info
# 启动成功后向白名单第一位用户发送一条「Bot 已上线」通知（0 关闭）
STARTUP_NOTICE=1
# 添加代理时的连通性测试地址（默认 https://www.gstatic.com/generate_204）
PROXY_TEST_URL=

# ---------- HTTP API（安卓 App 控制端） ----------
# 关闭改为 0；Telegram / 飞书控制不受影响。
# 默认开启但只监听回环地址，不能单独作为已配置的安卓控制端；
# 运行 npm run setup / npm run clients 可交互式填写下面的地址与 Token。
API_ENABLED=1
# 监听端口与地址；默认仅本机回环。局域网直连通常改 0.0.0.0，并通过
# API_PUBLIC_URL 告诉手机该访问哪个主机；反向代理/隧道/VPN 可保持回环。
API_PORT=3080
API_BIND=127.0.0.1
# 手机实际访问的地址：协议+域名/IP[:端口]，Bot 挂在反向代理子路径上时把该前缀一起写上
# （如 https://bot.example.com/agent-bot）；不要带查询串或 #片段。设置后 /api 的二维码才可扫码配对；
# 留空时只有 API_BIND 是具体地址才会生成二维码，否则 /api 只给出手动填写提示
API_PUBLIC_URL=
# 留空时首次启动自动生成并保存到 data/api-token.json；Telegram / 飞书中发 /api 可查看
# 由向导配置时会生成固定 Token，并直接打印配对地址与令牌。
API_TOKEN=
# 消息级加密（1 开启）：App 请求/响应体用 AES-256-GCM 加密，配对密钥存 data/api-enc-key.json
# 密钥经 /api 二维码下发；SSE、媒体流与导出/备份附件不加密。改动后需重启
API_ENCRYPTION=0

# ---------- 项目更新通道 ----------
# stable 跟随 main；beta 默认跟随 beta 分支（也可用 UPDATE_BRANCH 指定其他远端分支）。
# 更新会先在 data/releases/.staging-* 中克隆并构建，门禁通过后标记为 pending；
# 重启时才切换 current，启动健康检查失败会自动回滚。默认只保留 3 个 release。
UPDATE_CHANNEL=stable
UPDATE_BRANCH=main
# beta: UPDATE_CHANNEL=beta / UPDATE_BRANCH=beta

# ---------- magpie 模型网关（可选集成） ----------
# magpie CLI 二进制路径；留空时依次查找 ./bin/magpie 和 PATH
MAGPIE_BIN=
# magpie 本地网关地址（/magpie 面板用它做健康检查；不改也能用）
MAGPIE_URL=http://127.0.0.1:3425

# ---------- cc-switch（可选集成） ----------
# /cc 面板管理的应用类型：claude/codex/gemini/open-code/hermes/open-claw/pi
# 兼容写法：opencode -> open-code，openclaw -> open-claw
CC_SWITCH_APP=opencode
# cc-switch 二进制路径；留空时依次查找 ./bin/cc-switch 和 PATH
# 安装：npm run cc-switch:install
CC_SWITCH_BIN=

# ---------- 模型 Provider（opencode.json 中使用） ----------
MY_API_KEY=
GROK_API_KEY=

# ---------- 工具脚本凭据 ----------
SNIPER_EMAIL=
SNIPER_PASSWORD=
