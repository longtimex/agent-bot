# ---------- Telegram Bot ----------
# 在 Telegram 中向 @BotFather 发送 /newbot 获取
TELEGRAM_BOT_TOKEN=
# 允许使用机器人的 Telegram 用户 ID（逗号分隔）。留空将拒绝启动
TELEGRAM_ALLOW_USERS=
# 显式设为 1 才允许所有用户使用（不推荐）
TELEGRAM_ALLOW_ALL_USERS=0

# ---------- opencode server ----------
OPENCODE_URL=http://127.0.0.1:4096
# 与启动 `opencode serve` 时的 OPENCODE_SERVER_PASSWORD 一致
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# 使用的 agent（定义在 .opencode/agent/assistant.md）
OPENCODE_AGENT=assistant

# ---------- 任务超时 ----------
# 无活动超时（毫秒），两个引擎共用
TASK_TIMEOUT_MS=600000
# 任务绝对上限（毫秒），默认与无活动超时一致
TASK_MAX_TIMEOUT_MS=600000

# ---------- 定时提醒 ----------
# 提醒时间解析使用的 IANA 时区（与服务器时区无关）
REMINDER_TIMEZONE=Asia/Shanghai

# ---------- 其他 ----------
MAX_REPLY_LENGTH=1500
# 单条回复中单个图片/语音/文件最大大小（MB）
MAX_MEDIA_MB=20
# 允许媒体指令访问本机/内网地址（默认 0；仅在本地调试时临时设为 1）
MEDIA_ALLOW_PRIVATE_URLS=0
# 接收用户附件的大小上限（MB），Telegram Bot API 最大只允许 20
MAX_INPUT_MB=20
DATA_DIR=./data
LOG_LEVEL=info
# 添加代理时的连通性测试地址（默认 https://www.gstatic.com/generate_204）
PROXY_TEST_URL=

# ---------- 模型 Provider（opencode.json 中使用） ----------
MY_API_KEY=
GROK_API_KEY=

# ---------- 工具脚本凭据 ----------
SNIPER_EMAIL=
SNIPER_PASSWORD=
