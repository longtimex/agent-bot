# ---------- Telegram Bot ----------
# 首次运行 npm start 缺少配置时会自动进入连接向导；也可随时运行 npm run setup
# 在 Telegram 中向 @BotFather 发送 /newbot 获取 Token
TELEGRAM_BOT_TOKEN=
# 允许使用机器人的 Telegram 用户 ID（逗号分隔）。留空将拒绝启动
TELEGRAM_ALLOW_USERS=
# 显式设为 1 才允许所有用户使用（不推荐）
TELEGRAM_ALLOW_ALL_USERS=0

# ---------- opencode server ----------
OPENCODE_URL=http://127.0.0.1:4096
# 与启动 `opencode serve` 时的 OPENCODE_SERVER_PASSWORD 一致
OPENCODE_SERVER_USERNAME=opencode
OPENCODE_SERVER_PASSWORD=
# 使用的 agent（定义在 .opencode/agent/assistant.md）
OPENCODE_AGENT=assistant

# ---------- Agent CLI ----------
# 自定义 Agent CLI 档案路径；留空时读取 data/agents.json
# 内置 Claude Code / Codex / Gemini / Qwen / Qoder 等档案无需配置
AGENT_CLI_CONFIG=

# ---------- 任务超时 ----------
# 无活动超时（毫秒），所有引擎共用
TASK_TIMEOUT_MS=600000
# 任务绝对上限（毫秒），默认与无活动超时一致
TASK_MAX_TIMEOUT_MS=600000

# ---------- 定时提醒 ----------
# 提醒时间解析使用的 IANA 时区（与服务器时区无关）
REMINDER_TIMEZONE=Asia/Shanghai

# ---------- 每日用量报告 ----------
# 每天到点向白名单第一位用户推送一次用量汇总（0 关闭）
USAGE_DAILY_REPORT=0
# 推送时间（24 小时制 HH:MM，按 REMINDER_TIMEZONE 解析）
USAGE_DAILY_REPORT_TIME=21:00

# ---------- 其他 ----------
MAX_REPLY_LENGTH=1500
# 单条回复中单个图片/语音/文件最大大小（MB）
MAX_MEDIA_MB=20
# 允许媒体指令访问本机/内网地址（默认 0；仅在本地调试时临时设为 1）
MEDIA_ALLOW_PRIVATE_URLS=0
# 接收用户附件的大小上限（MB），Telegram Bot API 最大只允许 20
MAX_INPUT_MB=20
DATA_DIR=./data
LOG_LEVEL=info
# 启动成功后向白名单第一位用户发送一条「Bot 已上线」通知（0 关闭）
STARTUP_NOTICE=1
# 添加代理时的连通性测试地址（默认 https://www.gstatic.com/generate_204）
PROXY_TEST_URL=

# ---------- HTTP API（安卓 App 控制端） ----------
# 关闭改为 0；Telegram 控制不受影响
API_ENABLED=1
# 监听端口与地址；默认仅本机回环。手机访问需改 0.0.0.0 并配合反向代理/隧道/VPN
API_PORT=3080
API_BIND=127.0.0.1
# 留空时首次启动自动生成并保存到 data/api-token.json；Telegram 中发 /api 可查看
API_TOKEN=

# ---------- cc-switch（可选集成） ----------
# /cc 面板管理的应用类型：claude/codex/gemini/open-code/hermes/open-claw/pi
# 兼容写法：opencode -> open-code，openclaw -> open-claw
CC_SWITCH_APP=opencode
# cc-switch 二进制路径；留空时依次查找 ./bin/cc-switch 和 PATH
# 安装：npm run cc-switch:install
CC_SWITCH_BIN=

# ---------- 模型 Provider（opencode.json 中使用） ----------
MY_API_KEY=
GROK_API_KEY=

# ---------- 工具脚本凭据 ----------
SNIPER_EMAIL=
SNIPER_PASSWORD=
